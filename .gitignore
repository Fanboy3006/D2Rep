# 编译产物
target/
*.exe
*.pdb

# 离线Rust工具链与vendor依赖（体积大，另行同步）
rust_toolchain_*/
vendor/
offline_env_snapshot.tar.gz

# 录像文件与数据库（体积大，另行同步）
dems/
*.dem
*.db

# 运行时依赖DLL（可用脚本重新下载，体积小可选保留）
sqlite3.dll

# 密钥/环境变量
.env
.env.*

# 临时/草稿目录
.tmp/
.cargo-home/

# 系统文件
.DS_Store
Thumbs.db

downloads/

# 第4层分析产物（可随时重算，不入库）
analysis/output*/

# 生成的 HTML/图片产物（模块 B viewer 等）
dist/

# Python 编译缓存
__pycache__/
*.pyc

# 项目前人工统计（无意义，勿入库）
*.xlsx

# 中间/发布产物与调试日志（勿入库）
exceptions.txt
publish/
publish_repo/
dota_parse/src/bin/

# DSH 手机通知 / tailscale 桥接等本机工具，与项目无关，不入库
.dsh-ext/
